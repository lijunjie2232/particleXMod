<%
    const allPosts = [...site.posts.data].sort((a, b) => {
        const x = a.pinned ?? 0;
        const y = b.pinned ?? 0;
        return x === y ? b.date - a.date : y - x;
    });
    const current = (page.current - 1) * config.index_generator.per_page;
    const posts = allPosts.slice(current, config.index_generator.per_page + current);
    const colorHash = (str) => {
        let h = 0;
        for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) >>> 0;
        return theme.colors[h % theme.colors.length];
    };
%>
<% posts.forEach((post) => { %>
<article class="post">
    <a href="<%- url_for(post.path) %>">
        <h2 class="post-title"><%= post.title %></h2>
    </a>
    <div class="category-and-date">
        <% if (post.categories.data.length !== 0) { %>
        <span class="category">
            <a href="<%- url_for(post.categories.data[0].path) %>">
                <span class="icon">
                    <i class="fa-solid fa-bookmark fa-fw"></i>
                </span>
                <%= post.categories.data[0].name %>
            </a>
        </span>
        <% } %>
        <span class="date">
            <span class="icon">
                <i class="fa-solid fa-calendar fa-fw"></i>
            </span>
            <%- date(post.date, "YYYY/M/D") %>
        </span>
        <% if (theme.crypto.enable && typeof post.secret !== "undefined") { %>
        <span class="special" title="暗号化された記事">
            <i class="fa-solid fa-lock fa-fw"></i>
        </span>
        <% } %>
        <% if (typeof post.pinned !== "undefined") { %>
        <span class="special" title="ピン留め">
            <i class="fa-solid fa-thumbtack fa-fw"></i>
        </span>
        <% } %>
    </div>
    <% if (post.tags.data.length !== 0) { %>
    <div class="post-tags home-post-tags">
        <span class="icon">
            <i class="fa-solid fa-tags fa-fw"></i>
        </span>
        <% post.tags.data.forEach((tag) => { %>
        <span class="tag">
            <a href="<%- url_for(tag.path) %>" style="color: <%- colorHash(tag.name) %>"><%= tag.name %></a>
        </span>
        <% }); %>
    </div>
    <% } %>
    <div class="description">
        <div class="content" v-pre>
            <% if (typeof post.description !== "undefined") { %>
            <%- markdown(post.description) %>
            <% } else if (post.excerpt) { %>
            <%- post.excerpt %>
            <% } else { %>
            <%- post.content %>
            <% } %>
        </div>
    </div>
    <a href="<%- url_for(post.path) %>" class="go-post">続きを読む</a>
</article>
<% }); %>
